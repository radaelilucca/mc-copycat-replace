{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "NeoForge: Run Client",
      "type": "process",
      "command": "${workspaceFolder}\\gradlew.bat",
      "args": [
        "runClient"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gradle"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
