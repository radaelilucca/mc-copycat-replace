{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build All",
      "type": "process",
      "command": "${workspaceFolder}\\gradlew.bat",
      "args": [
        "buildAll",
        "--console=plain"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gradle"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
